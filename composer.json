{
    "name": "io/bakery",
    "description": "A bakery's online shop with pickup orders: the example app of Tenma, Io, Io Live and the Io plugins.",
    "type": "project",
    "license": "MIT OR Apache-2.0",
    "require": {
        "php": ">=8.5",
        "io/framework": "^0.1.6",
        "io/charts": "^0.1.0",
        "io/export": "^0.1.0",
        "io/flash": "^0.1.0",
        "io/i18n": "^0.1.1",
        "io/live": "^0.1.0"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "tenma/stubs": "^0.2.0"
    },
    "autoload": {
        "psr-4": {
            "Bakery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bakery\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
